# Public Supabase configuration used by the browser and Edge Function client.
# Obtain these from Supabase Project Settings -> API.
# These are public client values; the Resend API key must never be placed here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
